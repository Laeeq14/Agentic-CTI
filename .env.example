# .env.example — copy to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# Groq API Keys
# ---------------------------------------------------------------------------
# Primary Groq account (required).
GROQ_API_KEY=gsk_your_primary_key_here

# Optional overflow accounts for rate-limit rotation.
# The pipeline rotates to the next key on a 429 before sleeping.
# Remove or leave blank if you only have one account.
GROQ_API_KEY_2=gsk_your_second_key_here
GROQ_API_KEY_3=gsk_your_third_key_here

# Groq model name. Defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Qdrant vector store (optional — defaults to in-memory if unset)
# ---------------------------------------------------------------------------
# Uncomment and set to a local directory for persistent storage across runs.
# QDRANT_PATH=./qdrant_storage

# ---------------------------------------------------------------------------
# Elasticsearch log-query path (optional — only needed for log_query input mode)
# ---------------------------------------------------------------------------
# ES_HOST=http://localhost:9200
# ES_USER=elastic
# ES_PASSWORD=changeme
