# .env.example — copy to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# Groq API Keys
# ---------------------------------------------------------------------------
# Primary Groq account (required).
GROQ_API_KEY=gsk_your_primary_key_here

# Optional overflow accounts for rate-limit rotation.
# The pipeline rotates to the next key on a 429 before sleeping.
# Remove or leave blank if you only have one account.
GROQ_API_KEY_2=gsk_your_second_key_here
GROQ_API_KEY_3=gsk_your_third_key_here

# Groq model name. Defaults to qwen/qwen3.6-27b if unset.
# See https://console.groq.com for the current model catalog.
# NOTE: Groq free tier is limited to 8k TPM per request — large documents may
# fail with 413. Use OpenRouter or Cerebras below for full 100k char processing.
GROQ_MODEL=qwen/qwen3.6-27b

# ---------------------------------------------------------------------------
# OpenRouter (optional — higher context limits than Groq free tier)
# ---------------------------------------------------------------------------
# Get a free key at https://openrouter.ai/keys (no credit card required)
# When set, OpenRouter is used instead of Groq (unless CEREBRAS_API_KEY is also set).
# "openrouter/free" is a meta-model that routes to the best available free model
# (GPT-OSS-120B handles ~13% of this pool). Supports up to 1M token context.
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=openrouter/free

# ---------------------------------------------------------------------------
# Cerebras (optional — fastest inference, 128k context, free tier)
# ---------------------------------------------------------------------------
# Get a free key at https://cloud.cerebras.ai
# When set, Cerebras takes priority over OpenRouter and Groq.
# Current models (Llama/Qwen deprecated as of mid-2026):
#   gpt-oss-120b   — highest reasoning power (default)
#   gemma-4-31b    — lighter, multimodal
# CEREBRAS_API_KEY=csk-your-key-here
# CEREBRAS_MODEL=gpt-oss-120b

# ---------------------------------------------------------------------------
# Provider override (optional)
# ---------------------------------------------------------------------------
# Force a specific provider regardless of which keys are set.
# Valid values: groq | openrouter | cerebras
# LLM_PROVIDER=cerebras

# ---------------------------------------------------------------------------
# Qdrant vector store (optional — defaults to in-memory if unset)
# ---------------------------------------------------------------------------
# Uncomment and set to a local directory for persistent storage across runs.
# QDRANT_PATH=./qdrant_storage

# ---------------------------------------------------------------------------
# Elasticsearch log-query path (optional — only needed for log_query input mode)
# ---------------------------------------------------------------------------
# ES_HOST=http://localhost:9200
# ES_USER=elastic
# ES_PASSWORD=changeme
